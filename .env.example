# Copy this file to `.env.local` (gitignored) and fill in real values.
# Never commit real secrets — this file must only ever contain placeholders.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Server-side only — never expose this to web/, never bundle it into
# frontend code. The Express API (api/) is the only thing that should ever
# read this value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Anthropic
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
# Must be pinned to an exact model ID by whoever wires up the course-profile
# pipeline — do not leave this as a guess. If left as the placeholder below,
# api/src/lib/profile.js falls back to "claude-sonnet-5" (current as of this
# writing) — confirm that is still the right pinned id before deploying.
ANTHROPIC_MODEL_SONNET=replace-with-an-exact-pinned-model-id

# OpenAI (Whisper transcription for voice-memo notes)
# Server-side only — never expose this to web/. Used exclusively by
# api/src/lib/transcribe.js to call the Whisper API
# (POST /api/courses/:id/notes/voice). If left unset, that endpoint returns a
# clean 422 error instead of attempting a network call — see that file's
# module comment. Every test in this repo force-empties this var too (see
# api/test/setup.js), so tests never depend on a live key.
OPENAI_API_KEY=replace-with-openai-api-key

# Optional — a direct Postgres connection string (NOT the same as
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above, which only talk to the
# PostgREST/supabase-js REST layer). Only needed for the course-profile
# regeneration lock (api/src/lib/profileLock.js) to use a real
# `pg_try_advisory_xact_lock` instead of its single-process in-memory
# fallback — see that file's module comment. Safe to leave unset; the
# in-memory fallback is what every test in this repo runs against.
DATABASE_URL=replace-with-a-postgres-connection-string

# Auth
SESSION_SECRET=replace-with-a-long-random-string
KEVIN_EMAIL=kevin@example.com
KEVIN_PASSWORD_HASH=replace-with-a-bcrypt-hash

# Server
PORT=3003
